<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Proiect"
             x:Class="Proiect.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Font global modificabil -->
            <x:Double x:Key="FontSizeBase">14</x:Double>

            <!-- Stil global pentru Label -->
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            </Style>

            <!-- Stil global pentru Button -->
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            </Style>

            <!-- Stil global pentru Entry -->
            <Style TargetType="Entry">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            </Style>

            <!-- Stiluri externe -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>