<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Proiect"
             x:Class="Proiect.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Merged Dictionaries -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Resurse Globale -->
            <x:Double x:Key="FontSizeBase">16</x:Double>
            <x:String x:Key="FontFamilyBase">OpenSans-Regular</x:String> <!-- sau Arial / altceva -->
            <Color x:Key="TextColorBase">#212121</Color> <!-- Un gri închis -->

            <!-- Stil global pentru Label -->
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBase}" />
                <Setter Property="TextColor" Value="{DynamicResource TextColorBase}" />
            </Style>

            <!-- Stil global pentru Button -->
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBase}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="#1976D2" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <!-- Stil global pentru Entry -->
            <Style TargetType="Entry">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBase}" />
                <Setter Property="TextColor" Value="{DynamicResource TextColorBase}" />
            </Style>

            <!-- Stil global pentru Editor -->
            <Style TargetType="Editor">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBase}" />
                <Setter Property="TextColor" Value="{DynamicResource TextColorBase}" />
            </Style>

            <!-- Stil global pentru Picker -->
            <Style TargetType="Picker">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBase}" />
                <Setter Property="TextColor" Value="{DynamicResource TextColorBase}" />
            </Style>

            <!-- Stil global pentru SearchBar -->
            <Style TargetType="SearchBar">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBase}" />
                <Setter Property="TextColor" Value="{DynamicResource TextColorBase}" />
            </Style>

            <!-- Stil global pentru DatePicker -->
            <Style TargetType="DatePicker">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBase}" />
                <Setter Property="TextColor" Value="{DynamicResource TextColorBase}" />
            </Style>

            <!-- Stil global pentru TimePicker -->
            <Style TargetType="TimePicker">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBase}" />
                <Setter Property="TextColor" Value="{DynamicResource TextColorBase}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
