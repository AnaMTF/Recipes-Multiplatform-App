<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.CategoryRecipes"
             Title="{Binding CategoryName}">
    <CollectionView ItemsSource="{Binding Recipes}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="10" CornerRadius="10" HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecipeTapped" CommandParameter="{Binding .}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <Image Grid.RowSpan="3" 
                               Source="{Binding ImageUrl}" 
                               HeightRequest="100" 
                               WidthRequest="100" 
                               Aspect="AspectFill" />

                        <Label Grid.Column="1" 
                               Text="{Binding Name}" 
                               FontAttributes="Bold"
                               FontSize="Medium"
                               TextColor="#333"
                               Margin="10,0,0,5"/>

                        <Label Grid.Row="1" Grid.Column="1" 
                               Text="{Binding Description}" 
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               FontSize="Small"
                               TextColor="#666"
                               Margin="10,0,0,5"/>

                        <Label Grid.Row="2" Grid.Column="1" 
                               Text="{Binding Author, StringFormat='By {0}'}" 
                               FontSize="Small"
                               TextColor="#999"
                               Margin="10,0,0,0"/>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>