<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.Favourites"
             Title="Favorite Recipes">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Light Theme Colors -->
            <Color x:Key="PageBackgroundLight">#dbcdb5</Color>
            <Color x:Key="PrimaryColorLight">#ed6e3a</Color>
            <Color x:Key="SecondaryColorLight">#6c9e4f</Color>
            <Color x:Key="TextColorLight">#5e3c2c</Color>
            <Color x:Key="AccentColorLight">#a4330d</Color>
            <Color x:Key="LightAccentColorLight">#e9b08e</Color>
            <Color x:Key="CardBackgroundLight">White</Color>

            <!-- Dark Theme Colors -->
            <Color x:Key="PageBackgroundDark">#2d2d2d</Color>
            <Color x:Key="PrimaryColorDark">#ff8c5a</Color>
            <Color x:Key="SecondaryColorDark">#8bc573</Color>
            <Color x:Key="TextColorDark">#e6dfd7</Color>
            <Color x:Key="AccentColorDark">#ff6347</Color>
            <Color x:Key="LightAccentColorDark">#744838</Color>
            <Color x:Key="CardBackgroundDark">#3d3d3d</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="{StaticResource PageBackgroundLight}" 
                         Dark="{StaticResource PageBackgroundDark}"/>
    </ContentPage.BackgroundColor>

    <Grid RowDefinitions="Auto,*">
        <Label Text="Your Favorite Recipes" 
               FontSize="28" 
               Margin="20,15"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                        Dark={StaticResource TextColorDark}}"
               Grid.Row="0" />

        <CollectionView Grid.Row="1"
                      ItemsSource="{Binding FavoriteRecipes}"
                      SelectionMode="Single"
                      SelectionChanged="OnRecipeSelected"
                      Margin="10,0,10,10">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,8" 
                           Padding="15" 
                           CornerRadius="12" 
                           HasShadow="True"
                           BorderColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, 
                                                      Dark={StaticResource PrimaryColorDark}}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, 
                                                          Dark={StaticResource CardBackgroundDark}}">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFrameTapped" 
                                                 CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                            <!-- Recipe Image -->
                            <Frame Grid.RowSpan="3"
                                  CornerRadius="8"
                                  IsClippedToBounds="True"
                                  Padding="0"
                                  BorderColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                           Dark={StaticResource TextColorDark}}">
                                <Image Source="{Binding ImageUrl}"
                                     Aspect="AspectFill"
                                     HeightRequest="110" 
                                     WidthRequest="110" />
                            </Frame>

                            <!-- Recipe Name -->
                            <Label Grid.Column="1" 
                                  Text="{Binding Name}" 
                                  FontSize="18" 
                                  FontAttributes="Bold"
                                  TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                           Dark={StaticResource TextColorDark}}"
                                  Margin="15,0,0,5"/>

                            <!-- Recipe Description -->
                            <Label Grid.Row="1" 
                                  Grid.Column="1" 
                                  Text="{Binding Description}" 
                                  MaxLines="2"
                                  LineBreakMode="TailTruncation"
                                  TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                           Dark={StaticResource TextColorDark}}"
                                  Opacity="0.8"
                                  Margin="15,0,0,5"/>

                            <!-- Author -->
                            <Label Grid.Row="2" 
                                  Grid.Column="1" 
                                  Text="{Binding Author, StringFormat='By {0}'}" 
                                  FontSize="14"
                                  TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                           Dark={StaticResource TextColorDark}}"
                                  Opacity="0.7"
                                  Margin="15,0,0,0"/>

                            <!-- Favorite Button -->
                            <Button Grid.Row="2" 
                                   Grid.Column="1" 
                                   HorizontalOptions="End"
                                   Text="♥"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentColorLight}, 
                                                           Dark={StaticResource AccentColorDark}}"
                                   FontSize="28"
                                   Margin="0,-10,0,0"
                                   Padding="10"
                                   Clicked="OnRemoveFavoriteClicked"
                                   CommandParameter="{Binding Id}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Empty state when no favorites -->
            <CollectionView.EmptyView>
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, 
                                                      Dark={StaticResource CardBackgroundDark}}" 
                      Opacity="0.9"
                      CornerRadius="15"
                      Margin="20,10"
                      Padding="20"
                      BorderColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, 
                                                  Dark={StaticResource PrimaryColorDark}}"
                      HasShadow="True">
                    <VerticalStackLayout VerticalOptions="Center" 
                                        HorizontalOptions="Center" 
                                        Spacing="15">
                        <Label Text="No favorite recipes yet" 
                              FontSize="24" 
                              TextColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, 
                                                       Dark={StaticResource PrimaryColorDark}}"
                              FontAttributes="Bold"
                              HorizontalOptions="Center" />
                        <Label Text="Tap the heart icon on any recipe to add it to your favorites" 
                              FontSize="16"
                              TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                       Dark={StaticResource TextColorDark}}"
                              HorizontalOptions="Center"
                              MaxLines="2"
                              HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
