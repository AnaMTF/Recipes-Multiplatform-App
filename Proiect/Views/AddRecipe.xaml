<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.AddRecipe"
             Title="AddRecipe">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ProgressBar x:Name="FormProgressBar"
                 Grid.Row="0"
                 HeightRequest="20"
                 Margin="10" />
        
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="10" Padding="20" Margin="30">
                <Label Text="Add a new recipe" FontSize="Large" HorizontalOptions="Center" />
                <!-- Recipe Name -->
                <Border Stroke="Violet"
                    StrokeThickness="2"
                Padding="5"
                    StrokeShape="RoundRectangle 40,0,0,40">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <BoxView Color="Cornsilk" WidthRequest="40"/>
                    <Label Text="Recipe Name:"/>
                </StackLayout>
            </Border>
                <Entry x:Name="RecipeName" Placeholder="Enter recipe name" 
               TextChanged="OnEntryTextChanged"/>
                <!-- Description -->
                <Border Stroke="Violet"
                    StrokeThickness="2"
                Padding="5"
                    StrokeShape="RoundRectangle 40,0,0,40">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <BoxView Color="AliceBlue" WidthRequest="40"/>
                    <Label Text="Description:"/>
                </StackLayout>
            </Border>
            <Editor x:Name="Description" HeightRequest="100"
                    Placeholder="Enter description"
                TextChanged="OnEntryTextChanged"/>
                <!-- Ingredients -->
                <Border Stroke="Violet"
                    StrokeThickness="2"
                Padding="5"
                    StrokeShape="RoundRectangle 40,0,0,40">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <BoxView Color="Cornsilk" WidthRequest="40"/>
                    <Label Text="Ingredients:" />
                </StackLayout>
            </Border>
                <Picker x:Name="IngredientPicker" 
                Title="Select an ingredient" 
                SelectedIndexChanged="IngredientPicker_SelectedIndexChanged"/>
                <Button Text="Add Ingredient" Clicked="AddIngredient_Clicked"/>
                <CollectionView x:Name="IngredientsList" 
                        ItemsSource="{Binding SelectedIngredients}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding .}" />
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Steps -->
                <Border Stroke="Violet"
                    StrokeThickness="2"
                Padding="5"
                    StrokeShape="RoundRectangle 40,0,0,40">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <BoxView Color="Cornsilk" WidthRequest="40"/>
                    <Label Text="Steps:" />
                </StackLayout>
            </Border>
                <Editor x:Name="MethodEditor" Placeholder="Enter steps separated by ';'"
                TextChanged="OnEntryTextChanged" HeightRequest="100"/>
                <!-- Prepping Time -->
                <Border Stroke="Violet"
                    StrokeThickness="2"
                Padding="5"
                    StrokeShape="RoundRectangle 40,0,0,40">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <BoxView Color="Cornsilk" WidthRequest="40"/>
                    <Label Text="Prepping Time (minutes):" />
                </StackLayout>
            </Border>

                <Entry x:Name="PreppingTime" Placeholder="e.g., 30" 
               Keyboard="Numeric"
               TextChanged="OnTimeTextChanged" />
                <!-- Cooking Time -->
                <Border Stroke="Violet"
                    StrokeThickness="2"
                Padding="5"
                StrokeShape="RoundRectangle 40,0,0,40">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <BoxView Color="Cornsilk" WidthRequest="40"/>
                        <Label Text="Cooking Time (minutes):" />
                </StackLayout>
            </Border>

                <Entry x:Name="CookingTime" Placeholder="e.g., 60" 
               Keyboard="Numeric"
               TextChanged="OnTimeTextChanged" />
                <!-- Total Time -->
                <Border Stroke="Violet"
                    StrokeThickness="2"
                Padding="5"
                StrokeShape="RoundRectangle 40,0,0,40">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <BoxView Color="Cornsilk" WidthRequest="40"/>
                    <Label Text="Total Time:" />
                </StackLayout>
            </Border>
                <Label x:Name="TotalTimeLabel" 
               FontAttributes="Bold" 
               Text="0 minutes" />

                <Button Text="Save" Clicked="OnSaveClicked"/>
        </StackLayout>
    </ScrollView>
    </Grid>
</ContentPage>