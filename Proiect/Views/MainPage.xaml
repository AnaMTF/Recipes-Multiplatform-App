<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <!-- Header simplu cu titlu -->
            <Label x:Name="HeaderLabel"
                   Text="Bine ai venit la Cookbook!" 
                   FontSize="Large" 
                   HorizontalOptions="Center" 
                   Opacity="0"/>

            <!-- Search Bar -->
            <SearchBar x:Name="RecipeSearchBar" 
                       Placeholder="Caută rețetă" />

            <!-- Butoane de filtrare -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Popular" Clicked="OnFilterClicked" CommandParameter="Popular"/>
                <Button Text="Recent" Clicked="OnFilterClicked" CommandParameter="Recent"/>
                <Button Text="Favorite" Clicked="OnFilterClicked" CommandParameter="Favorite"/>
            </HorizontalStackLayout>

            <!-- Secțiune: Top Hottest Recipes (fundal roșu) -->
            <Border Stroke="Red" StrokeThickness="2" BackgroundColor="LightCoral" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10,10,10,10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Newest Recipes" FontSize="Title" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <CarouselView x:Name="RecipeCarousel" HeightRequest="200" ItemsSource="{Binding TopRecipes}">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Pink" StrokeThickness="1" Margin="10" BackgroundColor="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10,10,10,10"/>
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        <Label Text="{Binding Name}" 
                                               VerticalOptions="End" 
                                               HorizontalOptions="Center"
                                               BackgroundColor="#80000000"
                                               TextColor="White"
                                               Padding="10" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                </VerticalStackLayout>
            </Border>

            <!-- Secțiune: Categorii (fundal roz) -->
            <Border Stroke="HotPink" StrokeThickness="2" BackgroundColor="MistyRose" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10,10,10,10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Categorii" FontSize="Title" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <CollectionView ItemsSource="{Binding Categories}" HeightRequest="120">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Gray" StrokeThickness="1" Padding="10" Margin="5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10,10,10,10"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Image Source="{Binding ImageUrl}" HeightRequest="60" WidthRequest="100" Aspect="AspectFill"/>
                                        <Label Text="{Binding Name}" HorizontalOptions="Center" FontSize="Small"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <!-- Secțiune: Recomandate pentru tine (fundal galben) -->
            <Border Stroke="Orange" StrokeThickness="2"  BackgroundColor="LightYellow" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10,10,10,10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Recomandate pentru tine" FontSize="Title" FontAttributes="Bold"  HorizontalOptions="Center"/>
                    <CollectionView ItemsSource="{Binding RecommendedRecipes}" 
                                    ItemsLayout="HorizontalList" 
                                    HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Pink" StrokeThickness="2" Padding="10" Margin="5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10,10,10,10"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout>
                                        <Image Source="{Binding ImageUrl}" HeightRequest="100" WidthRequest="200" Aspect="AspectFill"/>
                                        <Label Text="{Binding Name}" FontSize="Small" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Picker pentru toate rețetele (opțional) -->
            <Picker x:Name="AllRecipesPicker" 
                    Title="Selectează o rețetă" 
                    ItemsSource="{Binding AllRecipes}" 
                    ItemDisplayBinding="{Binding Name}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
