<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <SearchBar Placeholder="Search a Recipe" PlaceholderColor="LightPink"/>

            <CarouselView x:Name="RecipeCarousel" HeightRequest="200" ItemsSource="{Binding TopRecipes}">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                            <Label Text="{Binding Name}" 
                               VerticalOptions="End" 
                               HorizontalOptions="Center"
                               BackgroundColor="#80000000"
                               TextColor="White"
                               Padding="10" />
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            <Picker x:Name="AllRecipesPicker" 
            Title="Select a Recipe" 
            ItemsSource="{Binding AllRecipes}"
            ItemDisplayBinding="{Binding Name}" />


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
