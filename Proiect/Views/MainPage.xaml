<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <!-- Header titlu -->
            <Label x:Name="HeaderLabel"
                   Text="Welcome to Culinary Creations!" 
                   FontSize="{DynamicResource FontSizeBase}" 
                   FontFamily="{DynamicResource FontFamilyBase}"
                   HorizontalOptions="Center" 
                   Opacity="0"
                   FontAttributes="Bold"
                   TextColor="#2EC35F" />

            <!-- Search Bar-->
            <SearchBar x:Name="RecipeSearchBar" 
                       Placeholder="Search Recipe" 
                       TextChanged="RecipeSearchBar_TextChanged" 
                       FontFamily="{DynamicResource FontFamilyBase}" />

            <!-- Secțiune pentru rezultatele de la search-->
            <CollectionView x:Name="SearchResultsCollectionView"
                            IsVisible="False"
                            ItemsSource="{Binding FilteredRecipes}"
                            Margin="0,10,0,10"
                            SelectionMode="Single"
                            SelectionChanged="SearchResultsCollectionView_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="Gray" StrokeThickness="1" Margin="5" Padding="5">
                            <Label Text="{Binding Name}" 
                                   FontSize="{DynamicResource FontSizeBase}" 
                                   FontFamily="{DynamicResource FontFamilyBase}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Secțiune: Top Hottest Recipes -->
            <Border Stroke="Red" StrokeThickness="2" BackgroundColor="LightCoral" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Newest Recipes" 
                           FontSize="{DynamicResource FontSizeBase}" 
                           FontFamily="{DynamicResource FontFamilyBase}" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />
                    
                    <CarouselView x:Name="RecipeCarousel" HeightRequest="200" ItemsSource="{Binding TopRecipes}">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Pink" StrokeThickness="1" Margin="10" BackgroundColor="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        <Label Text="{Binding Name}" 
                                               VerticalOptions="End" 
                                               HorizontalOptions="Center"
                                               BackgroundColor="#80000000"
                                               TextColor="White"
                                               Padding="10"
                                               FontFamily="{DynamicResource FontFamilyBase}"
                                               FontSize="{DynamicResource FontSizeBase}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                </VerticalStackLayout>
            </Border>

            <!-- Secțiune: Categorii -->
            <Border Stroke="HotPink" StrokeThickness="2" BackgroundColor="MistyRose" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Categories" 
                           FontSize="{DynamicResource FontSizeBase}" 
                           FontFamily="{DynamicResource FontFamilyBase}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    
                    <CollectionView ItemsSource="{Binding Categories}" HeightRequest="120"
                                    SelectionMode="Single"
                                    SelectionChanged="OnCategorySelected">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Gray" StrokeThickness="1" BackgroundColor="#FFB6C1" Padding="10" Margin="5"
                                        WidthRequest="120" HeightRequest="100">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Label Text="{Binding Name}" 
                                               FontSize="{DynamicResource FontSizeBase}" 
                                               FontFamily="{DynamicResource FontFamilyBase}" 
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               Grid.Row="1"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Secțiune: Recomandate pentru tine -->
            <Border Stroke="Orange" StrokeThickness="2" BackgroundColor="LightYellow" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="We think you might like these recipes :)" 
                           FontSize="{DynamicResource FontSizeBase}" 
                           FontFamily="{DynamicResource FontFamilyBase}" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                    
                    <CollectionView x:Name="RecommendedRecipesCollectionView" 
                        ItemsSource="{Binding RecommendedRecipes}" 
                        ItemsLayout="HorizontalList" 
                        HeightRequest="180" 
                        SelectionMode="Single"
                        SelectionChanged="RecommendedRecipes_SelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Pink" StrokeThickness="2" Padding="10" Margin="5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout>
                                        <Image Source="{Binding ImageUrl}" HeightRequest="100" WidthRequest="200" Aspect="AspectFill"/>
                                        <Label Text="{Binding Name}" 
                                               FontSize="{DynamicResource FontSizeBase}" 
                                               FontFamily="{DynamicResource FontFamilyBase}" 
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
