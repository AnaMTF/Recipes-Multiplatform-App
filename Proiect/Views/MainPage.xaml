<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <!-- Header simplu cu titlu -->
            <Label x:Name="HeaderLabel"
                   Text="Welcome to Culinary Creations!" 
                   FontSize="Large" 
                   HorizontalOptions="Center" 
                   Opacity="0"
                   FontAttributes="Bold"
                   TextColor="#2EC35F"/>

            <!-- Search Bar (cu handler pentru TextChanged) -->
            <SearchBar x:Name="RecipeSearchBar" 
                       Placeholder="Caută rețetă" 
                       TextChanged="RecipeSearchBar_TextChanged"/>

            <!-- Secțiune pentru rezultate de căutare -->
            <CollectionView x:Name="SearchResultsCollectionView"
                IsVisible="False"
                ItemsSource="{Binding FilteredRecipes}"
                Margin="0,10,0,10"
                SelectionMode="Single"
                SelectionChanged="SearchResultsCollectionView_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="Gray" StrokeThickness="1" Margin="5" Padding="5" >
                            <Label Text="{Binding Name}" FontSize="Medium"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Secțiune: Top Hottest Recipes (fundal roșu) -->
            <Border Stroke="Red" StrokeThickness="2" BackgroundColor="LightCoral" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10,10,10,10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Newest Recipes" FontSize="Title" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <CarouselView x:Name="RecipeCarousel" HeightRequest="200" ItemsSource="{Binding TopRecipes}">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Pink" StrokeThickness="1" Margin="10" BackgroundColor="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10,10,10,10"/>
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        <Label Text="{Binding Name}" 
                                               VerticalOptions="End" 
                                               HorizontalOptions="Center"
                                               BackgroundColor="#80000000"
                                               TextColor="White"
                                               Padding="10" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                </VerticalStackLayout>
            </Border>

            <!-- Secțiune: Categorii (fundal roz) -->
            <Border Stroke="HotPink" StrokeThickness="2" BackgroundColor="MistyRose" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10,10,10,10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Categorii" FontSize="Title" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <CollectionView ItemsSource="{Binding Categories}" HeightRequest="120">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Gray" StrokeThickness="1" BackgroundColor="#FFB6C1" Padding="10" Margin="5"
                                        WidthRequest="120" HeightRequest="100">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10,10,10,10"/>
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Label Text="{Binding Name}" 
                                               FontSize="Medium"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               Grid.Row="1"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Secțiune: Recomandate pentru tine (fundal galben) -->
            <Border Stroke="Orange" StrokeThickness="2" BackgroundColor="LightYellow" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10,10,10,10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Recomandate pentru tine" FontSize="Title" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <CollectionView x:Name="RecommendedRecipesCollectionView" 
                        ItemsSource="{Binding RecommendedRecipes}" 
                        ItemsLayout="HorizontalList" 
                        HeightRequest="180" 
                        SelectionMode="Single"
                        SelectionChanged="RecommendedRecipes_SelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Pink" StrokeThickness="2" Padding="10" Margin="5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10,10,10,10"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout>
                                        <Image Source="{Binding ImageUrl}" HeightRequest="100" WidthRequest="200" Aspect="AspectFill"/>
                                        <Label Text="{Binding Name}" FontSize="Small" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
