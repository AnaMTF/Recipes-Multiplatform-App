<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.EditRecipePage"
             Title="Edit Recipe">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Light Theme -->
            <Color x:Key="PageBackgroundLight">#dbcdb5</Color>
            <Color x:Key="PrimaryColorLight">#ed6e3a</Color>
            <Color x:Key="SecondaryColorLight">#6c9e4f</Color>
            <Color x:Key="TextColorLight">#5e3c2c</Color>
            <Color x:Key="AccentColorLight">#a4330d</Color>
            <Color x:Key="LightAccentColorLight">#e9b08e</Color>
            <Color x:Key="CardBackgroundLight">#fff7f0</Color>
            <Color x:Key="InputBackgroundLight">#e9b08e</Color>

            <!-- Dark Theme -->
            <Color x:Key="PageBackgroundDark">#2d2d2d</Color>
            <Color x:Key="PrimaryColorDark">#ff8c5a</Color>
            <Color x:Key="SecondaryColorDark">#8bc573</Color>
            <Color x:Key="TextColorDark">#e6dfd7</Color>
            <Color x:Key="AccentColorDark">#ff6347</Color>
            <Color x:Key="LightAccentColorDark">#744838</Color>
            <Color x:Key="CardBackgroundDark">#3d3d3d</Color>
            <Color x:Key="InputBackgroundDark">#fff7f0</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="{StaticResource PageBackgroundLight}"
                         Dark="{StaticResource PageBackgroundDark}" />
    </ContentPage.BackgroundColor>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Selector rețetă -->
            <Frame CornerRadius="12" HasShadow="True" Padding="15"
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                   BorderColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, Dark={StaticResource PrimaryColorDark}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Select a Recipe"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                    <Picker x:Name="recipePicker"
                            Title="Choose a recipe"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnRecipeSelected"
                            TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Formular într-un singur container -->
            <Frame CornerRadius="15" Padding="20" HasShadow="True"
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                   BorderColor="{AppThemeBinding Light={StaticResource SecondaryColorLight}, Dark={StaticResource SecondaryColorDark}}">

                <VerticalStackLayout Spacing="15">

                    <!-- Name -->
                    <Label Text="Name" TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                    <Entry x:Name="nameEntry"
                           Placeholder="Recipe name"
                           BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />

                    <!-- Description -->
                    <Label Text="Description" TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                    <Editor x:Name="descriptionEditor"
                            HeightRequest="80"
                            Placeholder="Add description"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />

                    <!-- Category -->
                    <Label Text="Category" TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                    <Picker x:Name="categoryPicker"
                            Title="Select a category"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />

                    <!-- Theme -->
                    <Label Text="Theme" TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                    <Picker x:Name="themesPicker"
                            Title="Select a theme"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />

                    <!-- Ingredients -->
                    <Label Text="Ingredients" TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                    <Editor x:Name="ingredientsEditor"
                            HeightRequest="100"
                            Placeholder="List of ingredients"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />

                    <!-- Method -->
                    <Label Text="Steps" TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                    <Editor x:Name="methodEditor"
                            HeightRequest="100"
                            Placeholder="Step by step"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />

                    <!-- Prepping Time -->
                    <Label Text="Prepping Time" TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                    <Entry x:Name="prepTimeEntry"
                           Placeholder="e.g. 10 min"
                           BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />

                    <!-- Cooking Time -->
                    <Label Text="Cooking Time" TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
                    <Entry x:Name="cookTimeEntry"
                           Placeholder="e.g. 30 min"
                           BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />

                    <!-- Save Button -->
                    <Button Text="Save Changes"
                            Clicked="OnSaveClicked"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryColorLight}, Dark={StaticResource SecondaryColorDark}}"
                            TextColor="White"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            Padding="12" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
