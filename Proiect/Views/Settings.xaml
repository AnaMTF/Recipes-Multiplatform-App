<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.Settings"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Titlu -->
            <Label 
                Text="App Settings"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="{DynamicResource TextColorPrimary}"
                HorizontalOptions="Center" />

            <!-- Setare temă -->
            <Frame BackgroundColor="{DynamicResource FrameBackground}"
                   BorderColor="{DynamicResource AccentColor}"
                   CornerRadius="15"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Theme"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextColorSecondary}" />
                    <Button x:Name="ThemeToggleButton"
                            Text="Switch to Dark Theme"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="8"
                            Clicked="OnThemeToggleClicked" />
                </VerticalStackLayout>
            </Frame>

            <!-- Setare mărime font -->
            <Frame BackgroundColor="{DynamicResource FrameBackground}"
                   BorderColor="{DynamicResource AccentColor}"
                   CornerRadius="15"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Font Size"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextColorSecondary}" />
                    <Picker x:Name="FontSizePicker"
                            Title="Select Font Size"
                            TextColor="{DynamicResource TextColorPrimary}"
                            SelectedIndexChanged="OnFontSizeChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Small</x:String>
                                <x:String>Medium</x:String>
                                <x:String>Large</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <Label Text="Preview Text"
                           FontSize="{DynamicResource FontSizeBase}"
                           TextColor="{DynamicResource TextColorPrimary}"
                           HorizontalOptions="Center"
                           FontAttributes="Italic" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
