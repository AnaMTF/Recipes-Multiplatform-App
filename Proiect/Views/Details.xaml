<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect.Views.Details"
             Title="Recipe Details">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Light Theme Colors -->
            <Color x:Key="PageBackgroundLight">#dbcdb5</Color>
            <Color x:Key="PrimaryColorLight">#ed6e3a</Color>
            <Color x:Key="SecondaryColorLight">#6c9e4f</Color>
            <Color x:Key="TextColorLight">#5e3c2c</Color>
            <Color x:Key="AccentColorLight">#a4330d</Color>
            <Color x:Key="LightAccentColorLight">#e9b08e</Color>
            <Color x:Key="CardBackgroundLight">White</Color>

            <!-- Dark Theme Colors -->
            <Color x:Key="PageBackgroundDark">#2d2d2d</Color>
            <Color x:Key="PrimaryColorDark">#ff8c5a</Color>
            <Color x:Key="SecondaryColorDark">#8bc573</Color>
            <Color x:Key="TextColorDark">#e6dfd7</Color>
            <Color x:Key="AccentColorDark">#ff6347</Color>
            <Color x:Key="LightAccentColorDark">#744838</Color>
            <Color x:Key="CardBackgroundDark">#3d3d3d</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="{StaticResource PageBackgroundLight}" 
                         Dark="{StaticResource PageBackgroundDark}"/>
    </ContentPage.BackgroundColor>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">
            <!-- Recipe Header Section -->
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <Label x:Name="RecipeName" 
                       Text="{Binding Name}" 
                       FontSize="28" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                Dark={StaticResource TextColorDark}}"
                       Grid.Row="0"
                       Grid.Column="0"/>

                <!-- Favorite Button -->
                <Button x:Name="FavoriteButton"
                        Text="♡"
                        FontSize="28"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource AccentColorLight}, 
                                                 Dark={StaticResource AccentColorDark}}"
                        Grid.Row="0"
                        Grid.Column="1"
                        Clicked="OnFavoriteClicked"/>

                <Label Text="{Binding Author, StringFormat='By {0}'}"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                Dark={StaticResource TextColorDark}}"
                       Opacity="0.8"
                       Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"/>
            </Grid>

            <!-- Recipe Image -->
            <Frame CornerRadius="10" 
                   Padding="0" 
                   IsClippedToBounds="True" 
                   HeightRequest="200"
                   BorderColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                             Dark={StaticResource TextColorDark}}"
                   HasShadow="True">
                <Image Aspect="AspectFill" Source="{Binding ImageUrl}"/>
            </Frame>

            <!-- Description Section -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, 
                                              Dark={StaticResource PrimaryColorDark}}" 
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, 
                                                  Dark={StaticResource CardBackgroundDark}}"
                   Opacity="0.9"
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description" 
                           FontAttributes="Bold" 
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, 
                                                    Dark={StaticResource PrimaryColorDark}}"/>
                    <Label Text="{Binding Description}" 
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                    Dark={StaticResource TextColorDark}}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Time Information -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource LightAccentColorLight}, 
                                                  Dark={StaticResource LightAccentColorDark}}" 
                   Opacity="0.9"
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                    <Label Text="Prep Time" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                    Dark={StaticResource TextColorDark}}"
                           Grid.Column="0" 
                           Grid.Row="0"/>

                    <Label Text="Cook Time" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                    Dark={StaticResource TextColorDark}}"
                           Grid.Column="1" 
                           Grid.Row="0"/>

                    <Label Text="Total Time" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                    Dark={StaticResource TextColorDark}}"
                           Grid.Column="2" 
                           Grid.Row="0"/>

                    <Label Text="{Binding PreppingTime}" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                    Dark={StaticResource TextColorDark}}"
                           Grid.Column="0" 
                           Grid.Row="1"/>

                    <Label Text="{Binding CookingTime}" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                    Dark={StaticResource TextColorDark}}"
                           Grid.Column="1" 
                           Grid.Row="1"/>

                    <Label Text="{Binding TotalTime}" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                    Dark={StaticResource TextColorDark}}"
                           Grid.Column="2" 
                           Grid.Row="1"/>
                </Grid>
            </Frame>

            <!-- Ingredients Section -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource SecondaryColorLight}, 
                                              Dark={StaticResource SecondaryColorDark}}" 
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, 
                                                  Dark={StaticResource CardBackgroundDark}}"
                   Opacity="0.9"
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ingredients" 
                           FontAttributes="Bold" 
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryColorLight}, 
                                                    Dark={StaticResource SecondaryColorDark}}"/>
                    <CollectionView ItemsSource="{Binding Ingredients}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,5">
                                    <Label Text="{Binding .}" 
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                                    Dark={StaticResource TextColorDark}}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Method Section -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, 
                                              Dark={StaticResource PrimaryColorDark}}" 
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, 
                                                  Dark={StaticResource CardBackgroundDark}}"
                   Opacity="0.9"
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Method" 
                           FontAttributes="Bold" 
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, 
                                                    Dark={StaticResource PrimaryColorDark}}"/>
                    <CollectionView ItemsSource="{Binding Method}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,5">
                                    <Label Text="{Binding .}" 
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                                    Dark={StaticResource TextColorDark}}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Category & Themes Section -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource SecondaryColorLight}, 
                                              Dark={StaticResource SecondaryColorDark}}" 
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, 
                                                  Dark={StaticResource CardBackgroundDark}}"
                   Opacity="0.9"
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True"
                   Margin="0,0,0,20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category" 
                           FontAttributes="Bold" 
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryColorLight}, 
                                                    Dark={StaticResource SecondaryColorDark}}"/>
                    <Label Text="{Binding Category}" 
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                    Dark={StaticResource TextColorDark}}"/>

                    <Label Text="Themes" 
                           FontAttributes="Bold" 
                           FontSize="18" 
                           Margin="0,10,0,0"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryColorLight}, 
                                                    Dark={StaticResource SecondaryColorDark}}"/>
                    <CollectionView ItemsSource="{Binding Themes}" HeightRequest="45">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource LightAccentColorLight}, 
                                                                      Dark={StaticResource LightAccentColorDark}}" 
                                       Padding="12,5" 
                                       CornerRadius="15"
                                       HasShadow="False"
                                       BorderColor="{AppThemeBinding Light={StaticResource AccentColorLight}, 
                                                                  Dark={StaticResource AccentColorDark}}">
                                    <Label Text="{Binding .}" 
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, 
                                                                    Dark={StaticResource TextColorDark}}"/>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
